# En-têtes de sécurité et de cache, lus par Cloudflare Pages (hébergement prévu
# après le départ de Lovable). Netlify sait aussi le lire.
#
# Tant que le site est servi par Lovable, ce fichier n'est PAS appliqué
# (vérifié le 22/09/2026 : Lovable le sert comme simple fichier texte).
# Sur Vercel, c'est vercel.json à la racine qui fait foi : garder les deux cohérents.

/*
  Content-Security-Policy: default-src 'self' capacitor: ionic:; script-src 'self' 'unsafe-inline' 'unsafe-eval' https://cdn.gpteng.co; style-src 'self' 'unsafe-inline' https://fonts.googleapis.com; font-src 'self' https://fonts.gstatic.com data:; img-src 'self' data: blob: https:; media-src 'self' data: blob: https:; connect-src 'self' capacitor: ionic: https://*.supabase.co wss://*.supabase.co https://*.supabase.in https://ai.gateway.lovable.dev https://ipapi.co; frame-ancestors 'none'; base-uri 'self'; form-action 'self' https://pay.jeko.africa; object-src 'none'; upgrade-insecure-requests
  X-Frame-Options: DENY
  X-Content-Type-Options: nosniff
  Strict-Transport-Security: max-age=31536000; includeSubDomains; preload
  Referrer-Policy: strict-origin-when-cross-origin
  Permissions-Policy: camera=(self), microphone=(self), geolocation=(self), payment=(), interest-cohort=()
  Cross-Origin-Opener-Policy: same-origin-allow-popups

# Fichiers du build avec un nom unique : on peut les garder en cache un an.
/assets/*
  Cache-Control: public, max-age=31536000, immutable

# Service workers et manifeste : toujours revérifiés, pour que les mises à jour
# de l'app (et des notifications) arrivent tout de suite.
/sw.js
  Cache-Control: no-cache, must-revalidate, max-age=0
/push-sw.js
  Cache-Control: no-cache, must-revalidate, max-age=0
/manifest.webmanifest
  Cache-Control: no-cache, must-revalidate, max-age=0
